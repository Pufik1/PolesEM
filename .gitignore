```php
<?php
// Include database connection
include_once('../../config/db_connect.php');
include_once('../../includes/functions.php');

if (!isset($_GET['id'])) {
    header("Location: warehouse_list.php");
    exit();
}

$id = $_GET['id'];

// Fetch write-off details
$stmt = $pdo->prepare("SELECT * FROM writeoffs WHERE id = ?");
$stmt->execute([$id]);
$writeoff = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$writeoff) {
    die("Write-off not found.");
}

// Fetch associated products
$stmt = $pdo->prepare("
    SELECT wp.*, p.name as product_name, p.unit 
    FROM writeoff_products wp 
    JOIN products p ON wp.product_id = p.id 
    WHERE wp.writeoff_id = ?
");
$stmt->execute([$id]);
$products = $stmt->fetchAll(PDO::FETCH_ASSOC);
?>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Print Write-off</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { text-align: center; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <div class="header">
        <h2>Write-off Document</h2>
        <p><strong>ID:</strong> <?php echo htmlspecialchars($writeoff['id']); ?></p>
        <p><strong>Date:</strong> <?php echo htmlspecialchars($writeoff['date']); ?></p>
        <p><strong>Reason:</strong> <?php echo htmlspecialchars($writeoff['reason']); ?></p>
    </div>

    <table>
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Unit</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($products as $product): ?>
            <tr>
                <td><?php echo htmlspecialchars($product['product_name']); ?></td>
                <td><?php echo htmlspecialchars($product['quantity']); ?></td>
                <td><?php echo htmlspecialchars($product['unit']); ?></td>
            </tr>
            <?php endforeach; ?>
        </tbody>
    </table>

    <script>
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>
```